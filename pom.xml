<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.noregressions.trace</groupId>
    <artifactId>manual</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Software Supply Chain Trace Lab Manual</name>


    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>



    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <version>0.1.0</version>

                <!--
                    Shared by every goal: what the book is, and how it renders.
                    Both executions below read this, and so does an ad-hoc
                    `mvn paperband:structure` — which then describes exactly the
                    book the PDF and site are built from.
                -->
                <configuration>
                    <!--
                        The book's own pieces live at the conventional home,
                        src/main/paperband/: layouts/ carries the page
                        header/footer templates and the diagnostics page,
                        assets/ the cover image. Content stays scattered
                        across the repo (setup/, workshop/, scenarios/, ...)
                        and is selected by the <sections> globs below —
                        <book><root> defaults to the module basedir, which is
                        exactly what those patterns resolve against.
                    -->
                    <theme>noregressions</theme>
                    <!--
                        The kind layer: scenario walkthroughs and tool
                        investigations get distinct identity furniture (badge,
                        title rule, section markers, command fences) on top of
                        the theme. The axis that drives it is declared inside
                        each <book> below.
                    -->
                    <stylesheets>
                        <stylesheet>src/main/paperband/styles/kind.css</stylesheet>
                        <stylesheet>src/main/paperband/styles/diagrams.css</stylesheet>
                        <stylesheet>src/main/paperband/styles/fences.css</stylesheet>
                    </stylesheets>
                    <!--
                        US Letter, with real margins: Chromium draws the
                        header/footer templates inside the page margin, so a
                        full-bleed margin of 0 would make them invisible.
                    -->
                    <pageSize>letter</pageSize>
                    <margins>14 12</margins>
                    <book>

                        <index>auto</index>
                        <cover>
                            <!-- Relative to the book home, src/main/paperband/. -->
                            <image>assets/kcdc2026-cover.jpeg</image>
                            <fullPage>true</fullPage>
                            </cover>
                        <title>You Don't Know What You're Shipping</title>
                        <header>
                            <template>page-header</template>
                        </header>
                        <footer>
                            <template>page-footer</template>
                        </footer>
                        <vars>
                            <subtitle>KCDC 2026 Workshop</subtitle>
                            <!--
                            <authors><author>Steve Poole</author>
                                <author>Brian Vermeer</author></authors>
                            -->
                            <!--
                                Static-site navigator: a sidebar listing every section and
                                the cards under it. Opt-in, and worth having at 21 cards.
                                Add sidebar_sections_collapsed=false to ship every section
                                expanded rather than click-to-open.
                            -->
                            <sidebar>true</sidebar>
                            <!-- Mermaid diagrams in the greyscale that matches
                                 the noregressions ink/grey system; colour in
                                 this book is semantic, and diagrams aren't. -->
                            <mermaidTheme>neutral</mermaidTheme>
                        </vars>
                        <!--
                            The kind axis: is this card a scenario walkthrough
                            (build and trace) or a tool investigation (point an
                            instrument at a boundary)? Valued per folder by
                            scenarios/paperband.yaml and
                            investigations/paperband.yaml, so cards need no
                            frontmatter of their own; workshop/ and setup/
                            cards have no kind and keep the plain theme voice.
                            Styling lives in the kind.css stylesheet above.
                        -->
                        <axes>
                            <axis>
                                <name>kind</name>
                                <title>Kind</title>
                                <!-- Label-only: classes, badges and site
                                     landing pages, but no divider pages —
                                     the Parts and appendices are the book's
                                     structure, not the kinds. -->
                                <dividers>false</dividers>
                                <values>
                                    <value>
                                        <id>scenario</id>
                                        <label>Scenario</label>
                                    </value>
                                    <value>
                                        <id>investigation</id>
                                        <label>Investigation</label>
                                    </value>
                                </values>
                            </axis>
                        </axes>
                        <sections>
                            <section >
                                <landingPage>false</landingPage>
                                <title>Welcome</title>
                                <includes>
                                <include>setup/frontpiece.md</include>
                                </includes>

                            </section>

                            <toc/>

                            <!--
                                The book embodies the workshop route: setup, then one section per
                                workshop section (presentation placeholder first, its labs after),
                                then appendices for everything off the timed route. Explicit
                                includes throughout — order is meaning here, and globs sweep.
                            -->
                            <section>
                                <title>Introduction and Setup</title>
                                <includes>

                                    <include>setup/00 about.md</include>

                                    <include>setup/01 getting-started.md</include>
                                    <include>setup/02 tools.md</include>
                                    <include>setup/03 ACCOUNTS-AND-KEYS.md</include>
                                    <include>setup/04 PREPULL-PREWARM.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 1 — Supply-Chain Fundamentals</title>
                                <includes>
                                    <include>workshop/01-supply-chain.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 2 — Can We Identify What We Ship?</title>
                                <includes>
                                    <include>workshop/02-identification.md</include>
                                    <include>scenarios/S01-spring-node/TRACE.md</include>
                                    <include>scenarios/S04-maven-plugin-hidden-content/TRACE.md</include>
                                    <include>scenarios/S05-node-prepack/TRACE.md</include>
                                    <include>scenarios/S03-python-pep517/TRACE.md</include>
                                    <include>investigations/T01-snyk-beyond-sbom/TRACE.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 3 — What Does a CVE Finding Actually Mean?</title>
                                <includes>
                                    <include>workshop/03-vulnerabilities.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 4 — CVEs Aren't Enough</title>
                                <includes>
                                    <include>workshop/04-project-health-eol.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 5 — What If Someone Exploits the Gaps?</title>
                                <includes>
                                    <include>workshop/05-integrity-provenance.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 6 — AI and the Supply Chain</title>
                                <includes>
                                    <include>workshop/06-ai-dependencies.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Part 7 — Wrap-Up</title>
                                <includes>
                                    <include>workshop/07-wrap-up.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Appendix — Optional Labs</title>
                                <includes>
                                    <include>scenarios/S02-payara-mvnpm/TRACE.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Appendix — The Tools</title>
                                <includes>
                                    <include>reference/tools.md</include>
                                </includes>
                            </section>
                            <!--
                                Site-only from here down: the per-tool reference
                                investigations are off the timed route and are the
                                sparsest content in the book, so the PDF stops at
                                the tools appendix (see the pdf execution's book
                                override below). The T01 per-scenario re-runs and
                                KNOWN-GROUND-TRUTH (instructor-demo track) are out
                                of both editions: T01/TRACE.md in Part 2 already
                                tells that story once.
                            -->
                            <section>
                                <title>Appendix — Reference Investigations</title>
                                <includes>
                                    <include>investigations/T02-docker-scout/TRACE.md</include>
                                    <include>investigations/T03-trivy-s01/TRACE.md</include>
                                    <include>investigations/T04-grype-s02/TRACE.md</include>
                                    <include>investigations/T05-pip-audit-s03/TRACE.md</include>
                                    <include>investigations/T06-owasp-dependency-check-s04/TRACE.md</include>
                                    <include>investigations/T07-npm-audit-s05/TRACE.md</include>
                                </includes>
                            </section>
                        </sections>
                    </book>
                </configuration>

                <executions>
                    <!-- Each execution contributes only where its output goes. -->
                    <execution>
                        <id>pdf</id>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <output>${project.build.directory}/book.pdf</output>
                            <!-- The pre-renderer HTML, for checking what the
                                 layout actually produced (card classes,
                                 badges, dividers) without opening the PDF. -->
                            <emitHtml>${project.build.directory}/book.html</emitHtml>
                            <!--
                                The printed book is the workshop handout: the timed
                                route plus the Optional Labs and tools appendices.
                                combine.self="override" replaces the shared <book>
                                wholesale (Maven merging would otherwise splice the
                                two section lists positionally), so this is a full
                                copy of the shared book minus the Reference
                                Investigations section — that stays in the site
                                edition above. Keep the two copies' common parts
                                in step when editing either.
                            -->
                            <book combine.self="override">

                                <index>auto</index>
                                <cover>
                                    <image>assets/kcdc2026-cover.jpeg</image>
                                    <fullPage>true</fullPage>
                                </cover>
                                <title>You Don't Know What You're Shipping</title>
                                <header>
                                    <template>page-header</template>
                                </header>
                                <footer>
                                    <template>page-footer</template>
                                </footer>
                                <vars>
                                    <subtitle>KCDC 2026 Workshop</subtitle>
                                    <sidebar>true</sidebar>
                                    <mermaidTheme>neutral</mermaidTheme>
                                </vars>
                                <!-- Kept in step with the shared book's kind axis above. -->
                                <axes>
                                    <axis>
                                        <name>kind</name>
                                        <title>Kind</title>
                                        <dividers>false</dividers>
                                        <values>
                                            <value>
                                                <id>scenario</id>
                                                <label>Scenario</label>
                                            </value>
                                            <value>
                                                <id>investigation</id>
                                                <label>Investigation</label>
                                            </value>
                                        </values>
                                    </axis>
                                </axes>
                                <sections>
                                    <section>
                                        <landingPage>false</landingPage>
                                        <title>Welcome</title>
                                        <includes>
                                            <include>setup/frontpiece.md</include>
                                        </includes>
                                    </section>

                                    <toc/>

                                    <section>
                                        <title>Introduction and Setup</title>
                                        <includes>
                                            <include>setup/00 about.md</include>
                                            <include>setup/01 getting-started.md</include>
                                            <include>setup/02 tools.md</include>
                                            <include>setup/03 ACCOUNTS-AND-KEYS.md</include>
                                            <include>setup/04 PREPULL-PREWARM.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 1 — Supply-Chain Fundamentals</title>
                                        <includes>
                                            <include>workshop/01-supply-chain.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 2 — Can We Identify What We Ship?</title>
                                        <includes>
                                            <include>workshop/02-identification.md</include>
                                            <include>scenarios/S01-spring-node/TRACE.md</include>
                                            <include>scenarios/S02-payara-mvnpm/TRACE.md</include>
                                            <include>scenarios/S03-python-pep517/TRACE.md</include>
                                            <include>scenarios/S04-maven-plugin-hidden-content/TRACE.md</include>
                                            <include>scenarios/S05-node-prepack/TRACE.md</include>
                                            <include>investigations/T01-snyk-beyond-sbom/TRACE.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 3 — What Does a CVE Finding Actually Mean?</title>
                                        <includes>
                                            <include>workshop/03-vulnerabilities.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 4 — CVEs Aren't Enough</title>
                                        <includes>
                                            <include>workshop/04-project-health-eol.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 5 — What If Someone Exploits the Gaps?</title>
                                        <includes>
                                            <include>workshop/05-integrity-provenance.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 6 — AI and the Supply Chain</title>
                                        <includes>
                                            <include>workshop/06-ai-dependencies.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Part 7 — Wrap-Up</title>
                                        <includes>
                                            <include>workshop/07-wrap-up.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Appendix — Optional Labs</title>
                                        <includes>
                                            <include>scenarios/S02-payara-mvnpm/TRACE.md</include>
                                        </includes>
                                    </section>
                                    <section>
                                        <title>Appendix — The Tools</title>
                                        <includes>
                                            <include>reference/tools.md</include>
                                        </includes>
                                    </section>
                                </sections>
                            </book>
                        </configuration>
                    </execution>
                    <execution>
                        <id>site</id>
                        <goals>
                            <goal>site</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site</outputDirectory>
                            <!-- Drop stale card pages when a card is removed or renamed. -->
                            <clean>true</clean>
                        </configuration>
                    </execution>
                    <!--
                        The same goal again, on Maven's `site` phase, so
                        `mvn site` builds the book's site too. Without this
                        `mvn site` runs only Maven's own reporting lifecycle,
                        which has nothing to do with this book (see the
                        maven-site-plugin entry below).
                    -->
                    <execution>
                        <id>site-lifecycle</id>
                        <phase>site</phase>
                        <goals>
                            <goal>site</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site</outputDirectory>
                            <clean>true</clean>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                `mvn site` means Maven's reporting lifecycle, not this book.
                This project is documentation: no Java, no dependency reports
                worth publishing, and project-info-reports 3.9.0 fails outright
                against the Doxia the current site plugin ships. Pinned (an
                unpinned version warns) and skipped, which leaves the `site`
                phase to the book's own site execution above.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
