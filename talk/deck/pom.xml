<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The Dev2Next talk deck, built by paperband from content/*.md.
        Standalone so the workshop book's shared plugin configuration does not
        apply to it. `mvn package` writes target/deck.pptx (native PowerPoint
        shapes, speaker notes in the notes pane) and target/deck.pdf.
    -->
    <groupId>dev.kcdc2026</groupId>
    <artifactId>talk-deck</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paperband.version>0.1.4</paperband.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <version>${paperband.version}</version>
                <!-- Opt-in: render-pptx pulls in Apache POI. -->
                <dependencies>
                    <dependency>
                        <groupId>dev.noregressions.paperband</groupId>
                        <artifactId>render-pptx</artifactId>
                        <version>${paperband.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <home>${project.basedir}</home>
                </configuration>
                <executions>
                    <execution>
                        <id>deck-pptx</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <output>${project.build.directory}/deck.pptx</output>
                            <renderer>pptx</renderer>
                        </configuration>
                    </execution>
                    <execution>
                        <id>deck-pdf</id>
                        <phase>package</phase>
                        <goals><goal>build</goal></goals>
                        <configuration>
                            <output>${project.build.directory}/deck.pdf</output>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
